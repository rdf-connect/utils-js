{
    "name": "@rdfc/utils-js",
    "version": "1.0.1",
    "description": "General utility library for the rdf-connect framework",
    "type": "module",
    "main": "./lib/index.js",
    "types": "./lib/index.d.ts",
    "exports": {
        ".": {
            "types": "./lib/index.d.ts",
            "default": "./lib/index.js"
        }
    },
    "files": [
        "lib/**/*"
    ],
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsc",
        "test": "vitest run --coverage --coverage.include src",
        "lint": "eslint src test",
        "prepare": "husky",
        "prepublishOnly": "npm run build"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/rdf-connect/utils-js"
    },
    "author": "",
    "license": "MIT",
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^25.9.9",
        "@typescript-eslint/eslint-plugin": "^8.72.1",
        "@typescript-eslint/parser": "^8.72.1",
        "@vitest/coverage-v8": "^5.0.5",
        "eslint": "^10.5.0",
        "eslint-config-prettier": "^10.1.8",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.0",
        "prettier": "^3.9.10",
        "typescript": "^6.0.3",
        "vitest": "^5.0.5"
    }
}
